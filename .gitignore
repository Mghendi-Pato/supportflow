# ============================================================
# SupportFlow — root .gitignore
# Covers: NestJS backend · Next.js frontend · Prisma · general
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment files — NEVER commit secrets ─────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Build outputs ─────────────────────────────────────────────
# NestJS
backend/dist/

# Next.js
frontend/.next/
frontend/out/

# ── Prisma ────────────────────────────────────────────────────
# Generated client — always regenerated via `prisma generate`
backend/node_modules/.prisma/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ── Testing ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── OS & editor files ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────
*.tsbuildinfo
.turbo/
.cache/
